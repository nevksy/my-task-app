# Supabase — Project Settings → API in the Supabase dashboard.
# Both values are safe to expose in the client bundle; Row Level Security is
# what protects the data. Copy this file to .env.local and fill in real values.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx_or_legacy_anon_jwt
